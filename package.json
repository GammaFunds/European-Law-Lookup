{
  "name": "european-law-lookup",
  "version": "0.5.2",
  "description": "Look up EU regulations, directives and decisions in 24 official languages, plus selected German, Austrian, Swiss and Spanish law. Preview legal text from official sources and insert formatted citations into your notes.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "tsc -p tsconfig.test.json && node --test \"test-dist/**/*.test.js\"",
    "lint": "eslint src"
  },
  "keywords": [
    "obsidian",
    "german-law"
  ],
  "author": "GammaFunds",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@typescript-eslint/eslint-plugin": "8.37.0",
    "@typescript-eslint/parser": "8.37.0",
    "esbuild": "^0.25.0",
    "eslint": "9.31.0",
    "eslint-plugin-obsidianmd": "0.4.2",
    "obsidian": "^1.13.0",
    "typescript": "^5.7.3"
  }
}
